{
  "status": "healthy",
  "service": "culinaria-recipe-vault",
  "version": "1.0.0",
  "buildType": "client-side-pwa",
  "deployment": {
    "provider": "static hosting",
    "sourceBranch": "deployment metadata",
    "healthModel": "static-artifact-metadata; no server-side SLA"
  },
  "clientFeatures": {
    "offlineCatalogReady": true,
    "curatedRecipesCount": 789,
    "serviceWorkerEnabled": true,
    "storageSecurityModel": "sanitized non-sensitive client-local data; not encrypted",
    "webAudioSupported": true,
    "speechSynthesisSupported": true
  },
  "verification": {
    "releaseMetadata": "dist/release.json",
    "requiredChecks": ["npm test", "npm run build", "npm audit --audit-level=high"]
  }
}
