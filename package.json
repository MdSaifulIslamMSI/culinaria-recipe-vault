{
  "name": "culinaria-recipe-finder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev": "vite --port 5173",
    "build": "vite build && node scripts/write-release-metadata.js",
    "preview": "vite preview",
    "test": "node --test tests/mealDbApi.test.js tests/serverApi.test.js tests/serverHardening.test.js tests/mealPlannerAndTimers.test.js tests/securityPenetration.test.js tests/frontendAccessibility.test.js tests/plannerFrontend.test.js tests/hardeningRegression.test.js",
    "test:e2e": "node --test \"tests/e2e/*.e2e.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "doctor": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.7.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
